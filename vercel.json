{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/about",
      "destination": "/"
    },
    {
      "source": "/join",
      "destination": "/"
    },
    {
      "source": "/volunteer",
      "destination": "/"
    },
    {
      "source": "/events",
      "destination": "/"
    },
    {
      "source": "/fall-festival",
      "destination": "/"
    },
    {
      "source": "/donate",
      "destination": "/"
    },
    {
      "source": "/fundraising",
      "destination": "/"
    },
    {
      "source": "/resources",
      "destination": "/"
    },
    {
      "source": "/contact",
      "destination": "/"
    },
    {
      "source": "/access",
      "destination": "/"
    },
    {
      "source": "/vendors",
      "destination": "/"
    },
    {
      "source": "/community-partners",
      "destination": "/"
    },
    {
      "source": "/sponsors",
      "destination": "/"
    },
    {
      "source": "/trunk-host",
      "destination": "/trunk-host.html"
    },
    {
      "source": "/admin",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/viking-quest",
      "destination": "/fall-festival",
      "permanent": true
    }
  ]
}
